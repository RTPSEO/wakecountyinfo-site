{
  // LIVE on wakecountyinfo.com (www redirects to the bare domain in src/worker.js).
  // The workers.dev URL stays up as a noindexed preview.
  "name": "wakecountyinfo-site",
  "workers_dev": true,
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "wakecountyinfo.com", "custom_domain": true },
    { "pattern": "www.wakecountyinfo.com", "custom_domain": true }
  ]
}
