{
  // DEV: served on the workers.dev URL only (noindexed in src/worker.js).
  // Go-live: once wakecountyinfo.com shows Active in Cloudflare, uncomment "routes" and push to main.
  "name": "wakecountyinfo-site",
  "workers_dev": true,
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
  // ,"routes": [
  //   { "pattern": "wakecountyinfo.com", "custom_domain": true },
  //   { "pattern": "www.wakecountyinfo.com", "custom_domain": true }
  // ]
}
